# ============================================================================
#  ESMO — Supabase 連線設定範本（Backend B1D）
#
#  用法：複製成 `.env.local` 再填值。`.env.local` 已在 .gitignore 裡。
#      cp .env.example .env.local
#
#  ⚠ **這個檔案裡永遠不填真值。** 它進版控，只用來說明有哪些欄位。
#  ⚠ 沒有填這兩個值時，遊戲**照常運作**：Cloud Save 會回報「未設定」，
#    存檔仍然完整寫在這台裝置上（LocalSaveProvider）。
#    程式不會因為缺設定就壞掉，也不會假裝雲端存成功了。
# ============================================================================

#  Supabase 專案的 URL，形如 https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

#  Supabase 的 **anon / publishable** key。
#
#  ⚠ 只能用 anon key。它是設計成可以出現在前端的——資料的保護來自 **RLS**
#    （見 supabase/migrations/），不是來自把 key 藏起來。
#  ⚠ **service_role key 絕對不可以放在這裡，也不可以放進這個 repo 的任何地方。**
#    它繞過所有 RLS，一旦進了前端 bundle 就等於把整個資料庫公開。
VITE_SUPABASE_ANON_KEY=

#  OAuth 登入完成後要導回的位址（留空 = 用目前的網址）。
#  ⚠ 這個值必須也登記在 Supabase 後台的 Auth → URL Configuration → Redirect URLs，
#    否則 Google 登入會在最後一步被擋掉。
#  正式站是 https://rayhuang0323.github.io/ESMO-/
VITE_SUPABASE_REDIRECT_URL=

#  是否允許匿名登入（dev / demo 用）。填 "1" 才會顯示那個入口。
#  ⚠ 需要同時在 Supabase 後台開啟 Auth → Providers → Anonymous sign-ins。
#  ⚠ 匿名帳號**換裝置就找不回來**，UI 必須照實說，不得講成「已備份」。
VITE_SUPABASE_ALLOW_ANONYMOUS=
