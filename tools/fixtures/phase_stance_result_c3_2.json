  "rules": {
    "perSidePerMetric": "paired over seeds: diff = mean(treatment - control); z = diff / (sd / sqrt(n)); rel = diff / mean(control). OK = sign(diff) matches the direction AND z in the direction >= 3 AND |rel| >= 0.05",
    "sidePass": "both metrics OK on that side",
    "verdicts": {
      "confirmed": "both sides pass",
      "duty_cycle_only": "the primary metric is OK on both sides but the start-only metric fails on at least one side",
      "one_sided": "exactly one side passes",
      "insufficient": "neither side passes and no reversal",
      "reversed": "on either side and either metric, z in the direction <= -3 (overrides the others)",
      "n_insufficient": "valid pairs < 200 on either side for either metric (overrides everything except STOP(INSTRUMENT)); no statistical verdict is emitted for that option"
    },
    "precedence": "the first matching verdict in this order: n_insufficient > reversed > confirmed > duty_cycle_only > one_sided > insufficient (so one side passing both metrics while the other passes only the primary metric is duty_cycle_only, not one_sided)",
    "zeroVariance": "if sd of the paired differences is 0: z = 0 when diff = 0, otherwise z = sign(diff) x 99 (as tacticTruthSim.pairStats); rel = null when the control mean is 0 (then the |Δ| >= 5 % condition is not met)",
    "noVerdictWhen": "the batch is incomplete, halted by STOP(INSTRUMENT) or STOP(CIRCUIT_BREAKER), or stale (src or fingerprint changed since the batch started, or meta.json missing): every verdict is null and the result fixture is not written",
    "minValidPairs": 200,
    "minValidPairsWhy": "D-19: late valid pairs n >= 200 (the original truth table had 23/40 late pairs); applied to every phase for uniformity (early/mid have 400 by construction unless a match ends before 9 minutes)",
    "multiplicity": "an option is confirmed only when 4 one-sided tests (2 metrics x 2 sides) each reach z >= 3 (p ~ 0.00135 each); 8 options. The family-wise chance of a false 'confirmed' is negligible; false 'reversed' per option needs one of 4 tests at z <= -3 (about 0.5 % per option, about 4 % over 8 options) and is reported as such.",
    "thresholdsFrom": "draft §1.3 (Owner mid-term ruling: fresh seeds, both sides, direction + paired z >= 3 + |Δ| >= 5 %, start-only version for duty-cycle metrics) and D-19 (n >= 200)"
  },
